// Vatech API Gateway - DBML (설계 초안)
//
// 작성: 초안 단계 산출물 -> baseline 시 vt-api-gateway/docs/specs/design/로 PR 이관.
// 구현 착수 후에는 Prisma schema로 이어진다(본 파일이 컬럼·타입·인덱스·relation SSOT).
//
// 시드 출처: "VT API Gateway - API 명세·데이터 모델·주권" §2 데이터 모델.
// GW의 핵심 역할 = 발신자 식별→올바른 client로 분배(GW는 payload 비해석). 본 DB는 '어디로 분배할지'의 지식을 보관:
//   라우팅 키(org_mapping)·provider 수신 config(webhook_provider)·target→host(upstream_registry)·분배 채널(delivery_channel).
// 컬럼은 snake_case(PostgreSQL 관례), API DTO는 camelCase(SRS §1.3)로 매핑.
// 시간은 Unix Timestamp(ms) bigint. PHI 본문 미저장(presigned 직결, SRS §6.4).
// 타입·인덱스·정밀 relation은 LLD(dev-chain-design)에서 확정.
// 2026-06-29 PR 정합 보강: upstream_registry 복원력 컬럼·enum화·created_at/updated_at·webhook_event 보강.
// 2026-07-01: region A안(device.region·region_mapping 제거·device.clinic_id 추가) · compat_matrix 제거 · 전 필드 주석.
// 2026-07-01: enrollment_token 제거 — 부트스트랩=LM 라이선스·Clinic-ID + C/S 사람 승인(사전 발급 토큰 없음). 승인 대기=device.pending(§2.3.1(2)·§7.2.5).
// 2026-07-01: 디바이스 인증=비대칭 private_key_jwt(개인키 서명→device.fingerprint 공개키 검증), 공유 secret 폐지(ADR-13·§7.1.1).
// 2026-07-01: credential 테이블 삭제 → device로 통합(client_id를 device.client_id nullable로 이관, secret_ref 폐기, hw_key_bound는 gw/1.1 attestation으로 이관). 13 테이블.
// 2026-07-01: token 테이블 삭제 — 무상태 JWT(서명 검증)·디바이스 단위 폐기라 발급 토큰 저장 불필요, 이력은 audit_log. 12 테이블.
// 2026-07-01: device.fingerprint → device.client_public_key 리네이밍 — 실제로 키페어 공개키라 'fingerprint'(하드웨어 지문 연상·LM machine fingerprint 충돌)를 정확한 명칭으로 교체(§7.2.6).

Project vt_api_gateway {
  database_type: 'PostgreSQL'
  Note: '설계 초안. 핵심 엔터티 골격만 — 상세 확정은 LLD.'
}

// ── 리뷰 포인트(설계 검토 필요) ──
//  1) [해결·2026-07-01 A안] region SSOT=clinic. device.region·region_mapping 제거, device.clinic_id 추가 →
//     device region은 clinic_region_mapping.region 파생(§6.4.1). 미결: clinic-less(비-EzServer) device의 region(미래·C안), 전용 clinic 테이블 분리 여부.
//  2) consent(재동의) 추적: 리전 재지정 시 재동의(FR-COMP-02·§7.9.5)·보존기간(Appendix B #5 TBD)을 위한 전용 테이블은 미정의 — ④/LLD에서 확정(현재는 audit_log + mapping_version으로 이력).
//  3) 보존기간(audit_log·consent)은 법규 의존 TBD(§6.4·Appendix B #5).

// 디바이스 lifecycle 상태(§7.2 상태기계)
Enum device_status {
  pending    // enroll 완료·C/S 승인 대기(인증 불가). pending→active는 C/S 승인 게이트(§7.2.3·§7.2.5)
  active     // 정상 운영(인증·호출 허용) — C/S 승인 후
  suspended  // 일시 정지(운영자/정책)
  revoked    // 폐기(자격 무효, 복구 불가)
}

// webhook 이벤트 처리 상태(§7.6)
Enum webhook_state {
  received    // 수신·큐(SQS) 적재됨
  dispatched  // 대상으로 분배 완료
  dead_letter // N회 재시도 실패 → DLQ
}

// upstream trust profile(§4.1.1, B 내부 / C 외부)
Enum upstream_profile {
  internal  // B: 사내 서비스(내부망, 예 cleverspace·oneid)
  external  // C: 제3자(OAuth·고정 egress IP, 예 axs)
}

// 분배 채널 종류(§7.6.5/6)
Enum delivery_channel_type {
  mqtt_edge   // Edge(EzServer) MQTT QoS1 하행
  http_cloud  // 클라우드 HTTP push
}

// GW 운영 리전 상태(§7.3.6)
Enum region_status {
  active    // 정상 운영
  draining  // 신규 배정 중단(기존만 유지)
  planned   // 계획(미개통)
}

// 디바이스 레지스트리 (FR-DEV-* · FR-AUTH-01)
Table device {
  device_id   varchar [pk]                                       // GW 디바이스 식별자(= EzServer 인스턴스, §1.4). **GW가 등록 시 생성 = UUIDv7**(RFC 9562·불투명·시간정렬, serial·clinic_id 비파생, §7.2.1·Appendix B #29 확정). 재설치·키 회전 시에도 유지. clinic_id는 LMP 발급이나 device_id는 GW 발급
  clinic_id   varchar [ref: > clinic_region_mapping.clinic_id]   // 소속 클리닉(FK). nullable(미래 클리닉 비소속 device). 등록 시 포함
  client_public_key varchar                                      // EzServer가 enrollment 시 생성한 키페어의 공개키(또는 key-id). private_key_jwt 서명 검증 키·디바이스 신원 바인딩(§7.1.1·ADR-13). **하드웨어/머신 지문 아님**(구 명칭 'fingerprint'을 정확화, LM Cryptlex machine fingerprint와 별개). 재설치=새 키→재-enroll로 회전(§7.2.6·7.2.7). nullable(enroll 전). v1.0 SW키, gw/1.1 TPM/SE
  client_id   varchar [unique]                                   // OAuth2 client id(고유). **GW가 enroll 시 생성 = `gwc_`+base64url(128비트 CSPRNG)**(불투명·내부 식별자 비파생, RFC 6749 §2.2·§7.2.5·Appendix B #28 확정). 공개 식별자(비밀 아님). **nullable** — client 자격 미발급 device(enroll 전·미래 비인증 device) 표현. 인증=private_key_jwt로 이 client_id + client_public_key(공개키) 검증(§7.1.1·ADR-13)
  status      device_status [not null, default: 'pending']       // lifecycle 상태(pending→active→suspended→revoked)
  created_at  bigint                                             // 생성(등록) 시각(Unix ms)
  updated_at  bigint                                             // 수정 시각(Unix ms)

  Note: 'GW 관점의 디바이스 = EzServer(클리닉당 1개 엣지 머신, §1.4). PHI 없음. lifecycle 상태기계(§7.2). **region은 컬럼 없음 — clinic_id→clinic_region_mapping.region 파생**(§6.4.1 A안, region SSOT=clinic). clinic_id·client_id nullable(client_id 없음=client 자격 미발급 device). **인증=private_key_jwt**(개인키=디바이스 보유, 공개키=client_public_key로 검증, 공유 secret 없음·ADR-13) — 별도 credential 테이블 없음(2026-07-01 통합). client_public_key는 구 명칭 \'fingerprint\'을 정확화(하드웨어 지문 아님). 개인키 보관 위치(SW/HW)는 gw/1.1 attestation(FR-ENR-06·FR-AUTH-07)에서 도입'
  Indexes {
    clinic_id  // 클리닉별 디바이스 조회
    status     // 상태별 조회(운영·정리)
  }
}

// (제거·2026-07-01) enrollment_token 테이블 삭제 —
//   부트스트랩 신뢰가 GW 사전 발급 토큰(공장 토큰/OOB)이 아니라 **LM 라이선스·Clinic-ID + C/S 사람 승인**으로 확정됨(§2.3.1(2)·§7.2.5).
//   따라서 저장할 사전 발급 토큰이 없음. 승인 대기 상태 = device.status='pending'(C/S 승인 시 active),
//   nonce challenge = Redis 휘발 상태, enroll/승인 이력 = audit_log. 별도 테이블 불필요.

// (제거·2026-07-01) credential 테이블 삭제 → device로 통합 —
//   비대칭 private_key_jwt(ADR-13)로 전환 후 자격 데이터가 client_id 하나만 남음(개인키=디바이스, 공개키=device.client_public_key).
//   client_id를 device.client_id(nullable·unique)로 이관("client_id 없는 device" optional 의미 유지). secret_ref는 공유 secret 폐지로 제거.
//   hw_key_bound는 v1.0에선 항상 false·검증 불가(attestation 필요)라 현재 스키마에서 제외 → gw/1.1 attestation(FR-ENR-06·FR-AUTH-07)에서 도입(ERD 미래).

// (제거·2026-07-01) token 테이블 삭제 —
//   발급 access token은 **무상태 JWT**(서명으로 검증, DB 조회 안 함·ADR-02). 폐기는 **디바이스 단위**(device.status revoked → lifecycle 차단, §7.2.4)이지 토큰 단위가 아니라 발급 토큰을 저장할 필요가 없음.
//   발급 이력은 audit_log가 담당. claim hard binding(FR-AUTH-05)은 발급 로직(§7.1.1)이 JWT에 넣는 것이지 테이블이 아님.
//   미래 토큰 단위 즉시 폐기가 필요해지면(gw/1.1) 발급마다 쌓는 표가 아니라 token_denylist(jti, exp)만 추가.

// (제거·2026-07-01 A안) device→region 매핑(region_mapping)은 삭제 —
//   region SSOT=clinic. device region은 device.clinic_id → clinic_region_mapping.region 파생(§6.4.1).
//   region 버전 마커(캐시 무효화·drift 감지·CAS)는 clinic_region_mapping.mapping_version, 값 이력·롤백은 audit_log(FR-RGN-02).

// clinic → region 매핑 겸 클리닉 레지스트리 (FR-RGN-06, 라우팅 키 통합)
Table clinic_region_mapping {
  clinic_id       varchar [pk]                                    // 클리닉 식별자(현재 클리닉 레지스트리 겸함 — 전용 clinic 테이블 분리는 R8 미결)
  region          varchar [not null, ref: > region_catalog.region_id]  // 이 클리닉의 배정 리전(FK, region SSOT)
  mapping_version integer [not null, default: 1]                  // 매핑 버전 — 변경마다 단조 증가(+1). 캐시 무효화·낙관적 동시성(CAS)·drift 감지용(FR-RGN-02·§7.3.2). **값 이력/롤백은 audit_log**(이 컬럼만으론 과거 값 없음)
  created_at      bigint                                          // 생성(클리닉 등록) 시각(Unix ms)
  updated_at      bigint                                          // 수정 시각(Unix ms)

  Note: '**클리닉→region 매핑 SSOT 겸 클리닉 레지스트리**(FR-RGN-06·ADR-10). region의 유일 진실원 — device는 region 컬럼 없이 clinic_id로 이 표를 참조해 region을 파생한다(§6.4.1 A안). **생성 = EzServer가 LMP에서 Clinic-ID 수신 시 자동·무조건 등록**(외부 연동 여부 무관, §2.3.1(1)) · Admin은 잘못된 등록의 교정(override)만(FR-RGN-04) — 일괄 수기 설정 아님. region 변경(relocation)은 mapping_version +1(캐시 무효화·drift 감지·CAS); 값 이력·롤백은 audit_log(FR-RGN-02). region은 region_catalog FK. device·org_mapping·webhook_event·delivery_channel이 clinic_id로 이 표를 참조(라우팅 허브). 전용 clinic 테이블 분리는 R8 미결'
}

// GW 운영 리전 카탈로그 (region list API SSOT) — §7.3.6 / FR-RGN-*
Table region_catalog {
  region_id    varchar [pk]                                 // 리전 식별자(예 apne2=서울, use1=미주)
  display_name varchar                                      // 사용자 표시명
  endpoint     varchar                                      // 리전 내부 endpoint(§4.5.1)
  status       region_status [not null, default: 'active']  // 운영 상태(active|draining|planned)
  is_default   boolean [not null, default: false]           // 기본 리전 여부(단일 리전/GeoDNS 기본값)
  created_at   bigint                                       // 생성 시각(Unix ms)
  updated_at   bigint                                       // 수정 시각(Unix ms)

  Note: '**GW 운영 리전 카탈로그**(region list API SSOT — GET /v1/regions, §7.3.6). GW가 서비스하는 리전 목록·표시명·endpoint·상태·기본값을 보관한다. 클리닉 등록/재지정 시 **선택 가능한 region 목록이 이 표에서 나오며**, clinic_region_mapping.region이 이 표를 FK로 참조한다(그 리전이 실존·운영 중임을 보장). v1.0=1행(단일 리전), gw/1.2=N행(§2.7.1 멀티리전-ready). status=draining이면 신규 배정 중단(기존만 유지)·planned는 미개통. 운영자가 관리(리전 개통·정리)'
}

// 업로드 세션 테이블 제거(2026-06-23): GW는 업로드 세션·presigned·storage를 소유하지 않음.
// 발급 주체=CleverSpace(②)/AXS(③), GW는 중계만(SRS §4.1.4·§7.4 · ADR-03/04 철회).

// 정책 (OPA 입력, FR-INT-03)
Table policy {
  id                varchar [pk]  // 정책 식별자
  tenant            varchar       // 적용 대상 테넌트(클리닉 등)
  connector         varchar       // 적용 대상 connector/target(예 axs)
  allowed_endpoints jsonb         // 허용 endpoint 목록(egress allowlist 판단)
  scopes            jsonb         // 허용 scope 집합
  egress            jsonb         // egress 규칙(고정 IP·대상 제한)
  created_at        bigint        // 생성 시각(Unix ms)
  updated_at        bigint        // 수정 시각(Unix ms)

  Note: '**정책 결정점(OPA) 입력 데이터**(FR-INT-03). (tenant, connector)별로 허용 endpoint·scope·egress 규칙을 보관 → 요청 시 OPA가 이 행을 근거로 allow/deny 판정. connector/target(예 axs)로의 호출이 허용 대상·리전·egress IP 규칙에 맞는지 검사. 실제 자격/host는 connector·upstream_registry, 본 표는 "무엇을 허용하는가"만'
  Indexes {
    (tenant, connector)  // 테넌트·connector 조합 조회
  }
}

// 외부 connector (FR-INT-01/02)
Table connector {
  name             varchar [pk]  // connector 이름(예 axs) — upstream_registry.target_id와 대응
  endpoint         varchar       // 외부 서비스 endpoint(base URL)
  credential_ref   varchar       // OAuth2 자격의 KMS 참조(§7.1.3)
  egress_allowlist jsonb         // egress 허용 대상 목록
  created_at       bigint        // 생성 시각(Unix ms)
  updated_at       bigint        // 수정 시각(Unix ms)

  Note: '**외부(C) connector 자격/엔드포인트**(FR-INT-01/02). 제3자 서비스(예 axs) 호출에 필요한 OAuth2 자격(원문 미저장 — KMS 참조)·base URL·egress 허용 목록. 라우팅(Vatech-Target→host)은 upstream_registry가, 정책 판정은 policy가 담당하고 **본 표는 "그 external을 실제 호출할 때 쓰는 자격·주소"**. name은 upstream_registry.target_id·policy.connector와 대응(예 axs)'
}

// 감사 로그 (FR-AUD-01)
Table audit_log {
  id     bigint [pk, increment]  // 감사 항목 식별자(자동 증가)
  ts     bigint [not null]       // 발생 시각(Unix ms)
  actor  varchar                 // 행위자(운영자 OneID/시스템)
  action varchar                 // 수행 동작(변경 유형)
  result varchar                 // 결과(성공/실패/거부 등)

  Note: '**감사 로그**(FR-AUD-01) — 규제(IEC 62304/ISO 13485) 대상 변경·접근 이력. append-only(UPDATE/DELETE 금지 — 위변조 방지). 누가(actor: 운영자 OneID/시스템)·언제(ts)·무엇을(action: 리전 변경·자격 발급·정책 수정 등)·결과(result)를 기록. 보존기간은 법규 의존 TBD(§6.4·Appendix B #5). consent(재동의) 이력도 현재는 여기+mapping_version으로 추적'
  Indexes {
    ts     // 시각 범위 조회
    actor  // 행위자별 조회
  }
}

// fleet 상태 (FR-FLEET-01/03)
Table fleet_state {
  device_id      varchar [pk, ref: - device.device_id]  // PK·FK → device(디바이스당 1개)
  last_heartbeat bigint                                 // 마지막 heartbeat 수신 시각(Unix ms)
  success_rate   decimal                                // 성공률(관측 지표)

  Note: '**fleet(디바이스 함대) 관측 상태**(FR-FLEET-01/03). device와 1:1(device_id PK 겸 FK). 디바이스별 마지막 heartbeat·성공률을 캐시해 온라인/오프라인·건강도 판단(콘솔 대시보드·이상탐지 입력). 원천 지표는 관측 파이프라인(§6.3.2), 본 표는 최신 상태 스냅샷'
}

// (제거·2026-07-01) 호환성 매트릭스는 DB 테이블 아님 —
//   릴리스 커플링 정적 설정이라 SSOT=소스 파일(① One Pager 동기화) → 빌드/CI로 well-known JSON 생성·공시
//   (design/well-known/server-configuration.*.json, §7.7.5·FR-COMPAT-05). 런타임 DB 미사용.
//   긴급 클라 버전 차단이 필요하면 일반 테이블이 아니라 Config push(§7.8.4)로 처리.

// 외부 이벤트 (FR-WH-*)
Table webhook_event {
  event_id        varchar [pk]                                        // 이벤트 식별자 = 멱등 키(중복 수신 dedup, §7.6.4)
  provider        varchar [not null, ref: > webhook_provider.provider] // 발신 provider(FK, 예 axs)
  external_org_id varchar                                             // provider의 org 식별자(예 AXS Org-ID) — 분배 대상 역조회 키
  clinic_id       varchar [ref: > clinic_region_mapping.clinic_id]    // 해석된 대상 클리닉(FK, org_mapping 조회 결과)
  region          varchar [ref: > region_catalog.region_id]          // 해석된 대상 리전(FK, clinic 파생)
  payload_ref     varchar                                            // 본문 참조(opaque — GW 비해석, 외부 스키마 ④)
  state           webhook_state [not null, default: 'received']      // 처리 상태(received|dispatched|dead_letter)
  target          varchar                                            // 해석된 분배 대상(채널/엔드포인트)
  attempts        integer [not null, default: 0]                     // 분배 시도 횟수(N회 실패 → dead_letter·DLQ, §7.6.3)
  last_error      varchar                                            // 마지막 분배 실패 사유(관측·DLQ 진단)
  received_at     bigint                                             // 수신 시각(Unix ms)
  dispatched_at   bigint                                             // 분배 완료 시각(Unix ms)

  Note: '**외부 webhook 이벤트 수신·분배 상태 기록**(FR-WH-*·§7.6). **Webhook Receiver가 수신 시 생성**(state=received)하고 **Webhook Dispatcher(§7.6.7)가 분배하며 갱신**(dispatched/dead_letter·attempts·last_error·dispatched_at). **멱등**: event_id가 멱등 키라 중복 수신을 dedup(§7.6.4). **GW는 payload를 해석하지 않고** external_org_id로 org_mapping을 조회해 대상 clinic→region을 해석(target에 저장). 본문은 payload_ref로만 참조(opaque·외부 스키마 ④, GW 미저장). 재시도 N회 실패 → dead_letter(DLQ, §7.6.3). 오래된 이벤트 보존/정리 정책은 운영·LLD'
  Indexes {
    provider   // provider별 조회
    state      // 상태별 조회(재시도·DLQ)
    clinic_id  // 클리닉별 조회
  }
}


// ── 분배 지식(라우팅) 레지스트리 — GW가 "누가 보냈는지→어디로" 를 이해하는 정보 ──

// Org-ID ↔ ClinicID 매핑 (webhook/inbound 라우팅 키)
Table org_mapping {
  provider        varchar [not null]                                  // 외부 provider(예 axs) — R8: 정규 토큰·레지스트리 FK 검토
  external_org_id varchar [not null]                                  // provider 식별자(예 AXS Organization-ID)
  clinic_id       varchar [not null, ref: > clinic_region_mapping.clinic_id]  // 대응 클리닉(FK)
  mapping_version integer [not null, default: 1]                      // 매핑 버전 — 변경마다 +1(단조). 캐시 무효화·CAS·drift 감지(clinic_region_mapping과 동일 의미, §7.3.2). 값 이력=audit_log
  created_at      bigint                                              // 생성 시각(Unix ms)
  updated_at      bigint                                              // 수정 시각(Unix ms)

  Note: '**(provider, external_org_id) → clinic_id 매핑 = webhook 분배 1차 라우팅 키**(§4.1.3·§7.6). 외부 이벤트(예 AXS)가 어느 클리닉(→ clinic_region_mapping으로 region)으로 갈지 역조회하는 표. **생성 = 외부 연동 연결 시 provider별 자가 등록**(§2.3.5, Straumann 온보딩 Org-ID) · Admin 교정(/admin/v1/org-mappings). (provider, external_org_id) 복합 PK, clinic_id 역인덱스로 양방향 조회(복구). **얇은 식별자 매핑**(§6.4.1 경계 — provider별 인증·payload 로직은 여기 아님; 구조 다른 provider는 전용 테이블·추가 개발). provider는 정규 토큰(R8: 레지스트리 FK 도입 검토)'
  Indexes {
    (provider, external_org_id) [pk]  // 복합 PK — (provider, 외부 org id) 유일
    clinic_id                         // 클리닉→외부 id 역조회
  }
}

// Webhook provider 레지스트리 (유연 수신·발신자 검증·라우팅 키 추출 config) FR-WH-01/02
Table webhook_provider {
  provider            varchar [pk]                        // provider 식별자(예 axs) — 정규 토큰
  inbound_host        varchar [unique]                    // **1차 식별 키** — provider별 전용 수신 호스트(예 axs.webhook.gw.vatech.com). Host/SNI로 발신자 식별(§7.6.1·§7.6.2)
  inbound_route       varchar                             // 등록된 수신 경로(유연; provider 규약 수용) — 확정 계약 아님
  sig_scheme          varchar                             // 서명/HMAC 방식(provider 규약) — **인증(신뢰)** 근거
  secret_ref          varchar                             // 검증 시크릿 참조(KMS) — Host로 선택된 provider의 HMAC 시크릿
  source_ip_allowlist jsonb                               // 허용 소스 **CIDR 목록** — **옵션·방어심층**(식별 용도 아님, Host가 대체). UI=③-C
  org_id_path         varchar                             // payload에서 external_org_id 추출 경로(JSONPath 등)
  enabled             boolean [not null, default: true]   // 활성 여부(수신 on/off)
  created_at          bigint                              // 생성 시각(Unix ms)
  updated_at          bigint                              // 수정 시각(Unix ms)

  Note: '식별=inbound_host(Host/SNI)로 provider·시크릿 선택, 인증=HMAC+timestamp(호스트명은 식별이지 인증 아님). source_ip는 옵션. GW는 payload 비해석, 본 config로 발신자 검증 + 라우팅 키만 추출(§4.1.3·§7.6.2). 경로/형식은 provider 규약 수용. 와일드카드 DNS 미사용 — provider별 명시 호스트(연단위 추가)'
}

// Vatech-Target → upstream host 레지스트리 (target-routed proxy, ADR-11)
Table upstream_registry {
  target_id           varchar [pk]                         // Vatech-Target 논리 ID(예 cleverspace, axs)
  host                varchar [not null]                   // 내부 매핑 host(클라이언트엔 비노출)
  profile             upstream_profile [not null]          // trust profile(internal=B / external=C)
  egress_allowlist    jsonb                                // external(C)일 때 egress 제한 대상
  connect_timeout_ms  bigint                               // TCP+TLS 핸드셰이크 타임아웃(짧게). 값 TBD(§7.5.4·Appendix B #25)
  response_timeout_ms bigint                               // upstream 응답 대기 타임아웃. 값 TBD
  total_deadline_ms   bigint                               // 프록시 호출 총 예산 — GW deadline < 클라이언트 타임아웃 불변식. 값 TBD
  retry_policy        jsonb                                // 재시도 설정 — 연결실패 한정·상한·budget(비멱등 POST 금지, §7.5.4)
  circuit_breaker     boolean [not null, default: false]   // 서킷 활성(503+Retry-After 빠른 실패). 임계·v1.0 범위 TBD
  enabled             boolean [not null, default: true]    // 활성 여부(라우팅 on/off)
  created_at          bigint                               // 생성 시각(Unix ms)
  updated_at          bigint                               // 수정 시각(Unix ms)

  Note: '프록시 라우팅(§4.1.2). 신규 upstream = 1행. external(C) 자격/egress 상세는 connector 연계. 타임아웃·재시도·서킷은 per-upstream 복원력 **설정**(§7.5.4) — 서킷 **런타임 상태(open/closed·카운터)는 pod-local in-memory로 비저장**, 본 표는 설정만(§2.2)'
}

// 분배 채널 (clinic → 어떤 방식으로 client에 전달) FR-WH-05/06
Table delivery_channel {
  clinic_id    varchar [pk, ref: - clinic_region_mapping.clinic_id]  // PK·FK → clinic(클리닉당 1개)
  channel_type delivery_channel_type [not null]                      // 분배 방식(mqtt_edge=Edge / http_cloud=클라우드)
  endpoint     varchar                                               // http_cloud endpoint 또는 mqtt 토픽 규약
  created_at   bigint                                                // 생성 시각(Unix ms)
  updated_at   bigint                                                // 수정 시각(Unix ms)

  Note: '**webhook 분배 마지막 단계 채널**(FR-WH-05/06). clinic과 1:1(clinic_id PK 겸 FK) — 해석된 대상 클리닉에 "어떤 방식으로" 이벤트를 전달할지. Edge=EzServer로 MQTT(클리닉 토픽, QoS1 하행) / Cloud=클라우드 클라이언트로 HTTP push. Webhook Dispatcher(§7.6.7)가 이 표를 조회해 발행. 클리닉 온보딩 시 생성. §7.6.5/6'
}
