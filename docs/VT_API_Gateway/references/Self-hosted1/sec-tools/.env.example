# Dependency-Track / SonarQube 접속 설정
# 이 파일을 .env 로 복사한 뒤 값을 채운다.  cp .env.example .env
#
# .env 는 절대 커밋하지 않는다(.gitignore 등록돼 있음).

# ── Dependency-Track ──────────────────────────────────────────
DTRACK_URL=http://dtrack.ewoosoft.com:8081
# 읽기 전용 API 키. 발급 방법은 README 의 "1단계" 참조.
DTRACK_API_KEY=

# ── SonarQube ─────────────────────────────────────────────────
SONAR_URL=http://sqube.ewoosoft.com
# 개인 계정 토큰. 발급 방법은 README 의 "2단계" 참조.
SONAR_TOKEN=
